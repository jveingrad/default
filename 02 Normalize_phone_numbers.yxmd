      <Properties>
        <Configuration>
          <Text>Sample Alteryx Workflow
Normalize phone numbers</Text>
          <Font name="Segoe UI" size="18" style="0" />
          <TextColor name="White" />
          <FillColor r="13" g="35" b="69" />
          <Shape shape="0" />
          <Justification Justification="0" />
