,A.RPRCTR AS ProfitCenter
,A.PC_LTEXT AS ProfitCenterDescription
,A.PROFITCENTER_TXJCD AS ProfitCenterJurisdiction
,A.PROFITCENTER_LAND1 AS ProfitCenterCountry
,A.RCNTR AS CostCenter
,COALESCE(C.COSTCENTER_LTEXT,'##') AS CostCenterDescription
,COALESCE(C.COSTCENTER_LAND1,'##') AS CostCenterCountry
,A.RACCT AS Account
,A.ACC_NUMBER_DESC AS AccountDescription
,CASE WHEN COALESCE(A.XBILK,'') = 'X' THEN true ELSE false END AS IsBalanceSheet
,A.RZZDESTGEO AS DestinationGeography
,A.T005T_LANDX50 AS DestinationGeographyDescription
,A.WAERS AS LocalCurrency
,A.COMPCODE_LTEXT AS LocalCurrencyDescription
,A.RZZPRODTYPE AS ProductType
,A.CV_DIM_TJPRPRTYPT_PRODUCTTYPETEXT_01_BEZEICHNUNG AS ProductTypeText
,'ENDING' AS Measure
,COALESCE(A.CY_CM_BAL_GC,0) AS Amount_Group
,COALESCE(A.CY_CM_BAL_LC,0) AS Amount_Local
from _SYS_BIC."app.ptc.mgmt.ccba.rep/CV_BS_ADH_REP_ZM_CCBA"
(
'PLACEHOLDER' = ('$$IP_ACCT_HIER$$','GTWDCTANFS')
,'PLACEHOLDER' = ('$$V_ACCT_NODE$$','GTWDCBS, GTWDCI1')
,'PLACEHOLDER' = ('$$IP_POPER$$','{Fiscal_Period}')
,'PLACEHOLDER' = ('$$IP_RYEAR$$','{Fiscal_Year}')
,'PLACEHOLDER' = ('$$IP_PM_POPER$$','000')
,'PLACEHOLDER' = ('$$IP_PM_RYEAR$$','0000')
,'PLACEHOLDER' = ('$$IP_PQ_POPER$$','000')
,'PLACEHOLDER' = ('$$IP_PQ_RYEAR$$','0000')
,'PLACEHOLDER' = ('$$IP_EX_TYPE$$','P')
,'PLACEHOLDER' = ('$$IP_RATE_DATE$$','1900-01-01')
,'PLACEHOLDER' = ('$$IP_TARGET_CURR$$','USD')
,'PLACEHOLDER' = ('$$IP_COBA_HIER$$','N/A')
,'PLACEHOLDER' = ('$$V_COBA_NODE$$','SECRPT')
,'PLACEHOLDER' = ('$$IP_BA_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_COMPCODE_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_COUNTRY_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_LOB_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_PC_KOKRS$$','TWDC')
,'PLACEHOLDER' = ('$$IP_PC_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_CC_KOKRS$$','TWDC')
,'PLACEHOLDER' = ('$$IP_CC_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_PT_KOKRS$$','TWDC')
,'PLACEHOLDER' = ('$$IP_SPRAS$$','E')
) AS A
LEFT OUTER JOIN _SYS_BIC."app.md.rep/CV_DIM_REP_MD_HIER_CC" AS C ON A.RCNTR = C.RCNTR
WHERE RYEAR = '{Fiscal_Year}'
--AND RBUKRS IN ('4013','4021','4028','4029','4324','4357')
--AND RBUKRS IN ('1955')
--AND RBUKRS IN ('8001','8002','8003','8004','8005','3082','3083','3084')
--AND RBUSA = '161'
),
Beginning AS
(
select  
A.RYEAR AS FiscalYear
,A.RBUKRS AS CompanyCode
,A.COMPCODE_BUTXT AS CompanyCodeDescription
,A.COMPCODE_KOKRS AS CompanyCodeControllingArea
,A.COMPCODE_LAND1 AS CompanyCodeCountry
,A.RBUSA AS BusinessArea
,A.BUSINESSAREA_GTEXT AS BusinessAreaDescription
,A.RPRCTR AS ProfitCenter
,A.PC_LTEXT AS ProfitCenterDescription
,A.PROFITCENTER_TXJCD AS ProfitCenterJurisdiction
,A.PROFITCENTER_LAND1 AS ProfitCenterCountry
,A.RCNTR AS CostCenter
,COALESCE(C.COSTCENTER_LTEXT,'##') AS CostCenterDescription
,COALESCE(C.COSTCENTER_LAND1,'##') AS CostCenterCountry
,A.RACCT AS Account
,A.ACC_NUMBER_DESC AS AccountDescription
,CASE WHEN COALESCE(A.XBILK,'') = 'X' THEN true ELSE false END AS IsBalanceSheet
,A.RZZDESTGEO AS DestinationGeography
,A.T005T_LANDX50 AS DestinationGeographyDescription
,A.WAERS AS LocalCurrency
,A.COMPCODE_LTEXT AS LocalCurrencyDescription
,A.RZZPRODTYPE AS ProductType
,A.CV_DIM_TJPRPRTYPT_PRODUCTTYPETEXT_01_BEZEICHNUNG AS ProductTypeText
,'BEGINNING' AS Measure
,COALESCE(A.CY_CM_BAL_GC,0) AS Amount_Group
,COALESCE(A.CY_CM_BAL_LC,0) AS Amount_Local
from _SYS_BIC."app.ptc.mgmt.ccba.rep/CV_BS_ADH_REP_ZM_CCBA"
(
'PLACEHOLDER' = ('$$IP_ACCT_HIER$$','GTWDCTANFS')
,'PLACEHOLDER' = ('$$V_ACCT_NODE$$','GTWDCBS, GTWDCI1')
,'PLACEHOLDER' = ('$$IP_POPER$$','{Fiscal_Period}')
,'PLACEHOLDER' = ('$$IP_RYEAR$$','{Fiscal_Year}')
,'PLACEHOLDER' = ('$$IP_PM_POPER$$','000')
,'PLACEHOLDER' = ('$$IP_PM_RYEAR$$','0000')
,'PLACEHOLDER' = ('$$IP_PQ_POPER$$','000')
,'PLACEHOLDER' = ('$$IP_PQ_RYEAR$$','0000')
,'PLACEHOLDER' = ('$$IP_EX_TYPE$$','P')
,'PLACEHOLDER' = ('$$IP_RATE_DATE$$','1900-01-01')
,'PLACEHOLDER' = ('$$IP_TARGET_CURR$$','USD')
,'PLACEHOLDER' = ('$$IP_COBA_HIER$$','BCS_SECRPT_FY25Q2')
,'PLACEHOLDER' = ('$$V_COBA_NODE$$','SECRPT')
,'PLACEHOLDER' = ('$$IP_BA_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_COMPCODE_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_COUNTRY_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_LOB_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_PC_KOKRS$$','TWDC')
,'PLACEHOLDER' = ('$$IP_PC_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_CC_KOKRS$$','TWDC')
,'PLACEHOLDER' = ('$$IP_CC_HIER$$','N/A')
,'PLACEHOLDER' = ('$$IP_PT_KOKRS$$','TWDC')
,'PLACEHOLDER' = ('$$IP_SPRAS$$','E')
) AS A
LEFT OUTER JOIN _SYS_BIC."app.md.rep/CV_DIM_REP_MD_HIER_CC" AS C ON A.RCNTR = C.RCNTR
WHERE RYEAR = '{Fiscal_Year}' 
AND POPER = '000'
--AND RBUKRS IN ('4013','4021','4028','4029','4324','4357')
--AND RBUKRS IN ('1955')
--AND RBUKRS IN ('8001','8002','8003','8004','8005','3082','3083','3084')
--AND RBUSA = '161'
)
SELECT * FROM Beginning WHERE Account &lt;='919999'
UNION
SELECT * FROM Ending WHERE Account &lt;='919999'</File>
