                      <InputConfiguration>
                        <Configuration>
                          <Passwords />
                          <File RecordLimit="" FileFormat="23">odbc:DSN=DFS EDP VPR|||WITH Ending AS
(
select  
A.RYEAR AS FiscalYear
,A.RBUKRS AS CompanyCode
,A.COMPCODE_BUTXT AS CompanyCodeDescription
,A.COMPCODE_KOKRS AS CompanyCodeControllingArea
,A.COMPCODE_LAND1 AS CompanyCodeCountry
